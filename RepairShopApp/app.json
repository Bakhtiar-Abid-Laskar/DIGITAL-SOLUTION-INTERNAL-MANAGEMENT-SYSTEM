{
  "expo": {
    "name": "Digital Solution",
    "slug": "digitalsolution",
    "scheme": "repairshop",
    "version": "1.0.3",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.repairshop.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Digital Solution uses the camera to capture attendance selfies and onsite visit photos.",
        "NSLocationWhenInUseUsageDescription": "Digital Solution uses your location to verify attendance check-in/check-out and onsite visit locations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.repairshop.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Digital Solution - Service & Repair",
      "shortName": "Digital Solution",
      "description": "Digital Solution Service Management System",
      "themeColor": "#2563EB",
      "backgroundColor": "#0B111E",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "en-IN"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Digital Solution uses the camera to capture attendance selfies and onsite visit photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Digital Solution uses your location to verify attendance check-in/check-out and onsite visit locations.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9e74d61a-0e68-4312-a3ce-4114cf44a72d"
      }
    },
    "owner": "bakhtiarabid02"
  }
}
