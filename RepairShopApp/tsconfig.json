{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "@repairshop/shared": ["./src/lib/shared/index.ts"],
      "@repairshop/shared/*": ["./src/lib/shared/*"]
    }
  },
  "exclude": [
    "supabase",
    "node_modules"
  ],
  "include": [
    "src/**/*",
    "index.ts"
  ]
}
